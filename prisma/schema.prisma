generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AccountType {
  id          BigInt @id @default(autoincrement())
  name        String @unique @db.VarChar(255)
  description String @db.VarChar(255)

  @@map("account_type")
}
